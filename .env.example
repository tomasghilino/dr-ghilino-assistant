# Copy to .env.local for local work (git-ignored). Production values live in InsForge secrets.
# Every variable is validated by packages/core/src/config/env.ts; run `pnpm cli config:check`.

APP_ENV=development

# --- LLM (server only) -------------------------------------------------------------------------
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
# low | medium | high
LLM_EFFORT=low
# Thinking counts toward this cap, so leave room above the short JSON answer.
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_MS=15000
LLM_MAX_RETRIES=2
# Tool rounds per visitor message, and the previous turns (pairs) the model sees.
AGENT_MAX_TOOL_ROUNDS=4
AGENT_HISTORY_TURNS=6
# Wall-clock budget for one visitor message, every model and tool call included.
TURN_DEADLINE_MS=20000

# --- Embeddings (server + ingestion) -------------------------------------------------------------
# voyage | openai-compatible (OpenAI, or the InsForge AI gateway at https://<project>.insforge.app/v1)
EMBEDDINGS_PROVIDER=voyage
EMBEDDINGS_MODEL=voyage-4
EMBEDDINGS_TIMEOUT_MS=8000
EMBEDDINGS_MAX_RETRIES=3
EMBEDDINGS_BATCH_SIZE=64
VOYAGE_API_KEY=
# Keys created in MongoDB Atlas use this host (the default).
VOYAGE_BASE_URL=https://ai.mongodb.com/v1
# OPENAI_COMPATIBLE_BASE_URL=
# OPENAI_COMPATIBLE_API_KEY=

# --- Retrieval ---------------------------------------------------------------------------------
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATES=20
RETRIEVAL_RRF_K=60
# Confidence gate (ADR 0011): pass on meaning (best cosine similarity) or on exact terms (share of
# the question's words found in one chunk). Tuned with `pnpm cli eval:retrieval`, see EVALUATION.md.
RETRIEVAL_MIN_SIMILARITY=0.35
RETRIEVAL_MIN_LEXICAL_COVERAGE=1
RETRIEVAL_MAX_CONTEXT_TOKENS=2000
# Drop a result mostly contained in a better-ranked one.
RETRIEVAL_DEDUPE_THRESHOLD=0.8
# In-memory cache of query embeddings, per function instance.
RETRIEVAL_QUERY_CACHE_SIZE=256
RETRIEVAL_QUERY_CACHE_TTL_MS=600000

# --- Chunking (ingestion) ----------------------------------------------------------------------
CHUNK_TARGET_TOKENS=220
CHUNK_MAX_TOKENS=400
CHUNK_OVERLAP_TOKENS=40

# --- Ingestion (admin CLI) ---------------------------------------------------------------------
INGEST_SOURCES_FILE=knowledge/sources.json
INGEST_FETCH_TIMEOUT_MS=15000
INGEST_MAX_BYTES=2000000
# Drop a chunk when this share of it is already covered by a more authoritative source.
DEDUPE_CONTAINMENT_THRESHOLD=0.8

# --- InsForge (server + ingestion). The admin key bypasses RLS: never ship it to a browser. -----
INSFORGE_BASE_URL=
INSFORGE_API_KEY=
# Public anon key. Not used by the API; only by `pnpm test:live` to prove it can reach nothing.
INSFORGE_ANON_KEY=

# --- HTTP and abuse control --------------------------------------------------------------------
ALLOWED_ORIGINS=https://drluisghilino.com.ar,https://www.drluisghilino.com.ar,http://localhost:5173
MAX_MESSAGE_CHARS=800
MAX_BODY_BYTES=8192
# At least 16 characters. Generate with: openssl rand -hex 32
RATE_LIMIT_SALT=
RATE_LIMIT_PER_MINUTE=8
RATE_LIMIT_PER_DAY=60
DAILY_BUDGET_USD=2
# Header with the client IP set by the platform proxy (hashed, used only for rate limits).
CLIENT_IP_HEADER=x-forwarded-for
# Bearer token for POST /internal/maintenance (InsForge schedule), 32+ characters: openssl rand -hex 32
# MAINTENANCE_TOKEN=

# --- Sessions ----------------------------------------------------------------------------------
# 32 random bytes, base64. Generate with: openssl rand -base64 32
SESSION_ENCRYPTION_KEY=
SESSION_TTL_MINUTES=30

# --- Safety ------------------------------------------------------------------------------------
# Shown for emergencies. Set by the administrator; the website does not publish emergency numbers.
# The practice should confirm both texts before production (defaults in packages/core/src/config/env.ts).
# SAFETY_EMERGENCY_TEXT=
# Shown when a message suggests a risk of self-harm (911, and the 135 line of the Centro de Asistencia al Suicida).
# SAFETY_CRISIS_TEXT=
# Prompt-leak canary shared by every instance, so the cached system prompt is reused. openssl rand -hex 8
# SAFETY_PROMPT_CANARY=
