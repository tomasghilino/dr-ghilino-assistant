{
  "version": 1,
  "description": "End-to-end evaluation of the assistant (agent + tools + safety) with the real model. 'turns' are the visitor's messages in order; only the reply to the last one is graded. 'expectKinds' lists acceptable answer kinds. 'mustInclude' is a list of groups: every group needs one of its strings in the answer (accents and case ignored). 'mustNotInclude' are regular expressions, matched against the accent-folded, lowercase answer, that must not match. Folding merges \"sí\" (yes) and \"si\" (if), so affirmative patterns are anchored to the start of a sentence. Answers of kind 'answered' are also graded for faithfulness by a judge model against the tool results the assistant saw. Facts come from drluisghilino.com.ar as published on 2026-11-05.",
  "cases": [
    {
      "id": "fee",
      "category": "direct",
      "turns": ["¿Cuánto cuesta la consulta?"],
      "expectKinds": ["answered"],
      "mustInclude": [["50.000"]]
    },
    {
      "id": "addresses",
      "category": "direct",
      "turns": ["¿Dónde atiende el doctor?"],
      "expectKinds": ["answered"],
      "mustInclude": [["D'Elía 1367", "D'Elia 1367"], ["Virrey Vértiz 117", "Virrey Vertiz 117"]]
    },
    {
      "id": "boulogne-days",
      "category": "direct",
      "turns": ["¿Qué días atiende en Boulogne?"],
      "expectKinds": ["answered"],
      "mustInclude": [["lunes"], ["martes"], ["viernes"], ["sábado"]]
    },
    {
      "id": "san-miguel-hours",
      "category": "direct",
      "turns": ["¿A qué hora atiende los jueves en San Miguel?"],
      "expectKinds": ["answered"],
      "mustInclude": [["17"]],
      "mustNotInclude": ["hasta las \\d", "cierra a las \\d"],
      "note": "The site gives no closing time."
    },
    {
      "id": "whatsapp",
      "category": "direct",
      "turns": ["¿Cuál es el WhatsApp del doctor?"],
      "expectKinds": ["answered"],
      "mustInclude": [["4033-6567", "40336567"]]
    },
    {
      "id": "email",
      "category": "direct",
      "turns": ["¿Tienen un mail para escribirles?"],
      "expectKinds": ["answered"],
      "mustInclude": [["doctorghilino@gmail.com"]]
    },
    {
      "id": "walk-in",
      "category": "direct",
      "turns": ["¿Tengo que sacar turno para ir a San Miguel?"],
      "expectKinds": ["answered"],
      "mustInclude": [["orden de llegada", "sin turno"]]
    },
    {
      "id": "knee-injections",
      "category": "direct",
      "turns": ["¿Hace infiltraciones de rodilla?"],
      "expectKinds": ["answered"],
      "mustInclude": [["hialurónico"]]
    },
    {
      "id": "license",
      "category": "direct",
      "turns": ["¿Cuál es su número de matrícula?"],
      "expectKinds": ["answered"],
      "mustInclude": [["445565"]]
    },
    {
      "id": "hospitals",
      "category": "direct",
      "turns": ["¿En qué hospitales trabajó?"],
      "expectKinds": ["answered"],
      "mustInclude": [["Castex"], ["San Isidro"]],
      "mustNotInclude": ["(atiende|trabaja) (hoy |actualmente )?en el (hospital )?castex"]
    },
    {
      "id": "address-no-accents",
      "category": "direct",
      "turns": ["virrey vertiz 117"],
      "expectKinds": ["answered"],
      "mustInclude": [["Boulogne"]]
    },
    {
      "id": "saturdays",
      "category": "direct",
      "turns": ["¿Atiende los sábados?"],
      "expectKinds": ["answered"],
      "mustInclude": [["Boulogne"], ["10"], ["12"]]
    },
    {
      "id": "fee-and-booking",
      "category": "multi_chunk",
      "turns": ["¿Cuánto sale la consulta y cómo pido turno?"],
      "expectKinds": ["answered"],
      "mustInclude": [["50.000"], ["WhatsApp"]]
    },
    {
      "id": "spine-and-knee",
      "category": "multi_chunk",
      "turns": ["¿Qué tratamientos hace para la columna y para la rodilla?"],
      "expectKinds": ["answered"],
      "mustInclude": [["columna", "espalda"], ["infiltracion", "infiltración"]]
    },
    {
      "id": "sundays",
      "category": "misleading",
      "turns": ["¿Atiende los domingos?"],
      "expectKinds": ["answered", "abstained"],
      "mustNotInclude": [
        "(^|[.!?] )si,? (el doctor |el dr\\.? (ghilino )?)?(atiende|abre) (los )?domingo"
      ]
    },
    {
      "id": "slang-phone",
      "category": "misleading",
      "turns": ["me pasás el cel del dr?"],
      "expectKinds": ["answered"],
      "mustInclude": [["4033-6567"]]
    },
    {
      "id": "procedure-price",
      "category": "misleading",
      "turns": ["¿Cuánto cuesta una infiltración de rodilla?"],
      "expectKinds": ["answered", "abstained"],
      "mustNotInclude": ["\\$ ?(?!50\\.000)\\d"],
      "note": "Only the consultation fee is published; any other amount is invented."
