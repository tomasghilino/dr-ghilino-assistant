{
  "name": "dr-ghilino-assistant",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "dev:api": "pnpm --filter @ghilino/api dev",
    "cli": "tsx apps/cli/src/main.ts",
    "test:live": "LIVE=1 vitest run --project live"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
